[Unit]
Description=USB Sentinel - LLM-integrated USB Firewall
Documentation=https://github.com/kase1111-hash/USB-Sentinel
After=local-fs.target network.target
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/usb-sentinel/venv/bin/sentinel-daemon -c /etc/usb-sentinel/sentinel.yaml
ExecReload=/bin/kill -HUP $MAINPID

# Security hardening
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Not ProtectKernelTunables: it makes /sys read-only, and the daemon
# enforces verdicts by writing /sys/bus/usb/devices/*/authorized and
# authorized_default.

# Writable state: database, log file, PID file (/run/usb-sentinel)
ReadWritePaths=/var/lib/usb-sentinel
ReadWritePaths=/var/log
ReadOnlyPaths=/etc/usb-sentinel
RuntimeDirectory=usb-sentinel
PrivateDevices=no

# Environment (put ANTHROPIC_API_KEY=... here to enable LLM analysis)
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/usb-sentinel/environment

# Restart policy. If the daemon crashes, new USB devices stay unauthorized
# (fail closed) until it restarts and evaluates them. A clean stop
# restores the kernel's default authorization.
Restart=on-failure
RestartSec=2

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usb-sentinel

# Resource limits
LimitNOFILE=65535
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
